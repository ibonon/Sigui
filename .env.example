# ─── Circle ───────────────────────────────────────────────────────────────────
CIRCLE_API_KEY=your_circle_api_key_here
ARCWARDEN_WALLET_ID=your_wallet_id_here
ARCWARDEN_WALLET_ADDRESS=0xYourArcWardenWalletAddress
PAYER_WALLET_ID=your_payer_wallet_id_here
ATTACKER_WALLET_ID=your_attacker_wallet_id_here
MONITOR_WALLET_ID=your_monitor_wallet_id_here
LEARNER_WALLET_ID=your_learner_wallet_id_here

# ─── Arc Testnet ──────────────────────────────────────────────────────────────
ARC_RPC_URL=https://rpc.arc-testnet.network
ARC_CHAIN_ID=1234
ARC_USDC_TOKEN_ADDRESS=0xYourArcUSDCContractAddress
ARC_SIGNER_PRIVATE_KEY=your_arc_signer_private_key_here
ARC_SIGNER_ADDRESS=0xYourArcSignerAddress
ARC_RECEIPT_TIMEOUT_S=30
ARC_REQUIRED_CONFIRMATIONS=1

# ─── Anthropic (Claude — fallback escalation + self-critique) ─────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here
DECISION_AI_ENABLED=true
DECISION_AI_MODEL=claude-sonnet-4-20250514
DECISION_AI_TIMEOUT_S=3
CREWAI_ENABLED=true

# ─── Lebe — Qwen2.5-3B on AMD MI300X (primary escalation engine) ─────────────
# vLLM serve command on MI300X:
#   VLLM_USE_TRITON_FLASH_ATTN=0 vllm serve Qwen/Qwen2.5-3B-Instruct \
#     --served-model-name lebe --api-key sigui-key \
#     --port 8001 --max-model-len 8192 --gpu-memory-utilization 0.30
LEBE_ENABLED=true
LEBE_ENDPOINT=http://134.199.201.220:8001/v1/chat/completions
LEBE_MODEL_NAME=lebe
LEBE_API_KEY=sigui-key
LEBE_TIMEOUT_S=4.0
LEBE_MOCK_MODE=false
# Set to false to disable Claude fallback (Lebe-only mode)
LEBE_FALLBACK_TO_CLAUDE=true

# ─── ArcWarden Pricing ────────────────────────────────────────────────────────
ARCWARDEN_EVAL_PRICE_USDC=0.001
ARCWARDEN_ESCALATE_PRICE_USDC=0.003

# ─── Database ─────────────────────────────────────────────────────────────────
DB_PATH=./db/arcwarden.db
ECOSYSTEM_BASE_URL=http://localhost:8000
ECOSYSTEM_METRICS_PATH=./ecosystem/metrics.json
DEMO_REPORT_PATH=./ecosystem/demo_report.json

# ─── Demo Mode (set to true to run without real blockchain/Circle keys) ───────
DEMO_MODE=true
INITIAL_BALANCE_USDC=0.60

# ─── Hogonat DAO Governance (on-chain mode) ───────────────────────────────────
# Leave HOGONAT_CONTRACT_ADDRESS empty to keep mock mode (safe default).
# Set it after running: python scripts/deploy_hogonat.py
HOGONAT_CONTRACT_ADDRESS=
HOGONAT_USDC_TOKEN_ADDRESS=0x3600000000000000000000000000000000000000
HOGONAT_USDC_DECIMALS=6
HOGONAT_MIN_STAKE_USDC=0.01

# ─── Sigui P1 Vision (Imina Na) ───────────────────────────────────────────────
VISION_ENABLED=true
VISION_MOCK_MODE=false
VISION_ENDPOINT=http://134.199.201.220:8002/v1/chat/completions
VISION_MODEL_NAME=imina-na
